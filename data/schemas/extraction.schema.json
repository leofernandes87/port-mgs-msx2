{
  "type": "object",
  "properties": {
    "manifest": {
      "$ref": "#/$defs/SourceManifest"
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250
          },
          "layout_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "metatile_set_ref": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "graphics_set_ref": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "palette_ref": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "status": {
            "enum": [
              "decoded",
              "undefined"
            ]
          },
          "expanded_tiles": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "static_collision": {
            "type": "array",
            "items": {
              "enum": [
                0,
                1
              ]
            }
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "id",
          "layout_ref",
          "metatile_set_ref",
          "graphics_set_ref",
          "palette_ref",
          "status",
          "expanded_tiles",
          "static_collision",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 251,
      "maxItems": 251
    },
    "layouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Layout"
      }
    },
    "metatile_sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MetatileSet"
      },
      "minItems": 6,
      "maxItems": 6
    },
    "collision_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CollisionProfile"
      },
      "minItems": 7,
      "maxItems": 7
    },
    "tilesets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "tile_pixel_width": {
            "const": 8
          },
          "tile_pixel_height": {
            "const": 8
          },
          "color_map": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 8,
            "maxItems": 8
          },
          "pixels_by_tile": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  "minItems": 64,
                  "maxItems": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "minItems": 256,
            "maxItems": 256
          },
          "loads": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "destination": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "flip_x": {
                  "type": "boolean"
                },
                "evidence": {
                  "$ref": "#/$defs/Evidence"
                }
              },
              "required": [
                "destination",
                "count",
                "flip_x",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "unloaded_tile_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "id",
          "tile_pixel_width",
          "tile_pixel_height",
          "color_map",
          "pixels_by_tile",
          "loads",
          "unloaded_tile_ids",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "palettes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "registers": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "id",
          "registers",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "maxItems": 16
    },
    "palette_base": {
      "type": "object",
      "properties": {
        "default_register_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 16,
          "maxItems": 16
        },
        "menu_patch": {
          "type": "object",
          "properties": {
            "registers": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "evidence": {
              "$ref": "#/$defs/Evidence"
            }
          },
          "required": [
            "registers",
            "evidence"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "display_conversion": {
          "type": "string"
        }
      },
      "required": [
        "default_register_pairs",
        "menu_patch",
        "evidence",
        "display_conversion"
      ],
      "additionalProperties": false
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 0
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "door_id": {
            "type": "integer",
            "minimum": 0
          },
          "render_type_id": {
            "type": "integer",
            "minimum": 0
          },
          "draw_y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "draw_x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "destination_room_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "open_logic_raw": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "open_rule_id": {
            "type": "integer",
            "minimum": 0
          },
          "region_profile_raw": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 8,
            "maxItems": 8
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "rule_evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "region_evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "room_id",
          "ordinal",
          "door_id",
          "render_type_id",
          "draw_y",
          "draw_x",
          "destination_room_id",
          "open_logic_raw",
          "open_rule_id",
          "region_profile_raw",
          "evidence",
          "rule_evidence",
          "region_evidence"
        ],
        "additionalProperties": false
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 0
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "actor_type_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "path_binding": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "room_id",
          "ordinal",
          "actor_type_id",
          "y",
          "x",
          "path_binding",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source_label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "points_yx",
              "look_directions_raw"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "id",
          "source_label",
          "kind",
          "values",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "room_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 0
          },
          "ordered_path_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "binding_status": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "room_id",
          "ordered_path_refs",
          "binding_status",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 0
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "item_type_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "availability_rule": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          }
        },
        "required": [
          "room_id",
          "ordinal",
          "item_type_id",
          "y",
          "x",
          "availability_rule",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "type": "integer",
            "minimum": 0
          },
          "table_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "destinations": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/$defs/Evidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "room_id",
          "table_index",
          "destinations",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "room_id",
          "kind",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "manifest",
    "rooms",
    "layouts",
    "metatile_sets",
    "collision_profiles",
    "tilesets",
    "palettes",
    "palette_base",
    "doors",
    "entities",
    "paths",
    "room_paths",
    "items",
    "connections",
    "diagnostics",
    "limitations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metal-gear-lab:extraction:0.1.0",
  "$defs": {
    "Evidence": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "rom_offset": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_address": {
          "type": "integer",
          "minimum": 0
        },
        "bank": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "binary_verified"
        }
      },
      "required": [
        "file",
        "line",
        "symbol",
        "rom_offset",
        "cpu_address",
        "bank",
        "length",
        "status"
      ],
      "additionalProperties": false
    },
    "Layout": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "grid_width": {
          "const": 8
        },
        "grid_height": {
          "const": 6
        },
        "id_base": {
          "const": 1
        },
        "metatile_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "minItems": 48,
          "maxItems": 48
        },
        "source_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "id",
        "grid_width",
        "grid_height",
        "id_base",
        "metatile_ids",
        "source_labels",
        "evidence"
      ],
      "additionalProperties": false
    },
    "MetatileSet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "tile_width": {
          "const": 4
        },
        "tile_height": {
          "const": 4
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 16,
            "maxItems": 16
          }
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "id",
        "tile_width",
        "tile_height",
        "definitions",
        "evidence"
      ],
      "additionalProperties": false
    },
    "CollisionProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "movement_blocked_by_tile": {
          "type": "array",
          "items": {
            "enum": [
              0,
              1
            ]
          },
          "minItems": 256,
          "maxItems": 256
        },
        "scope": {
          "const": "static_movement_only"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "id",
        "movement_blocked_by_tile",
        "scope",
        "evidence"
      ],
      "additionalProperties": false
    },
    "SourceManifest": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "0.1.0"
        },
        "tool_version": {
          "type": "string"
        },
        "reference_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "input_size": {
          "type": "integer",
          "minimum": 0
        },
        "input_crc32": {
          "type": "string",
          "pattern": "^[0-9A-F]{8}$"
        },
        "input_sha1": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_role": {
          "enum": [
            "canonical"
          ]
        },
        "rom_profile": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "verification_scope": {
          "type": "string"
        },
        "verified_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "length": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "files",
              "offset",
              "length",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "required": [
        "format_version",
        "tool_version",
        "reference_commit",
        "input_size",
        "input_crc32",
        "input_sha1",
        "input_sha256",
        "input_role",
        "rom_profile",
        "verification_scope",
        "verified_segments",
        "source_hashes"
      ],
      "additionalProperties": false
    }
  }
}
