{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metal-gear-lab:room-snapshot:1.0.0",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "1.0.0"
    },
    "room_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 250
    },
    "width": {
      "const": 256
    },
    "height": {
      "const": 192
    },
    "pixels": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 17
      },
      "minItems": 49152,
      "maxItems": 49152
    },
    "palette_rgb": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 18,
      "maxItems": 18
    },
    "collision": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 768,
      "maxItems": 768
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "format_version",
    "room_id",
    "width",
    "height",
    "pixels",
    "palette_rgb",
    "collision",
    "input_sha256",
    "source"
  ],
  "additionalProperties": false
}
